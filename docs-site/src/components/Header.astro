---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const navItems = [
	{ label: "What's New", href: '/releases/', section: '/releases' },
	{ label: 'Features', href: '/features/dashboard/', section: '/features/' },
	{ label: 'Deployment', href: '/deployment/desktop/', section: '/deployment/' },
	{ label: 'Configuration', href: '/configuration/', section: '/configuration' },
];

const currentPath = Astro.url.pathname;
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<div class="middle sl-flex print:hidden">
		<nav class="top-nav sl-hidden lg:sl-flex" aria-label="Main">
			<ul>
				{
					navItems.map((item) => (
						<li>
							<a href={item.href} aria-current={currentPath.startsWith(item.section) ? 'true' : undefined}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<div class="search sl-flex">
			{shouldRenderSearch && <Search />}
		</div>
	</div>
	<div class="sl-hidden lg:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<div class="theme-select sl-hidden lg:sl-flex">
			<ThemeSelect />
		</div>
		<LanguageSelect />
	</div>
</div>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}

		.middle {
			align-items: center;
			gap: 1rem;
			min-width: 0;
		}

		.right-group,
		.social-icons {
			gap: 1rem;
			align-items: center;
		}
		.social-icons::after {
			content: '';
			height: 2rem;
			border-inline-end: 1px solid var(--sl-color-gray-5);
		}

		.top-nav ul {
			display: flex;
			gap: 0.25rem;
			list-style: none;
			margin: 0;
			padding: 0;
		}
		.top-nav a {
			display: flex;
			align-items: center;
			gap: 0.25rem;
			padding: 0.5rem 0.65rem;
			border-radius: 0.375rem;
			color: var(--sl-color-gray-2);
			font-size: var(--sl-text-sm);
			text-decoration: none;
			white-space: nowrap;
		}
		.top-nav a:hover {
			color: var(--sl-color-white);
		}
		.top-nav a[aria-current='true'] {
			color: var(--sl-color-text-accent);
		}

		@media (min-width: 50rem) {
			.header {
				display: grid;
				grid-template-columns: auto 1fr auto;
				align-content: center;
			}
			.search {
				flex: 1;
				justify-content: flex-end;
			}
		}
	}
</style>
